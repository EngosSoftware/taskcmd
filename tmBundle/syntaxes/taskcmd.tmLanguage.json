{
  "name": "taskcmd",
  "scopeName": "source.taskcmd",
  "patterns": [
    {
      "name": "note.taskcmd",
      "match": "(^\\s*\\.)(note\\s*)(.*)",
      "captures": {
        "2": {
          "name": "comment.line.taskcmd"
        },
        "3": {
          "name": "comment.line.taskcmd"
        }
      }
    },
    {
      "name": "description.taskcmd",
      "match": "(^\\s*\\.)(desc\\s*)(.*)",
      "captures": {
        "2": {
          "name": "keyword.taskcmd"
        },
        "3": {
          "name": "string.taskcmd"
        }
      }
    },
    {
      "name": "variable.taskcmd",
      "match": "(^\\s*\\.)([A-Z_]+)",
      "captures": {
        "2": {
          "name": "constant.other.taskcmd"
        }
      }
    },
    {
      "name": "node.taskcmd",
      "match": "(^\\s*\\.)([^\\s]+)",
      "captures": {
        "2": {
          "name": "keyword.taskcmd"
        }
      }
    },
    {
      "name": "interpolation.taskcmd",
      "match": "(\\{\\{[^\\}]*\\}\\})",
      "captures": {
        "1": {
          "name": "constant.other.taskcmd"
        }
      }
    }
  ]
}
